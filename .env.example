# 百度AI配置
VITE_BAIDU_AI_API_KEY=your_api_key_here
VITE_BAIDU_AI_SECRET_KEY=your_secret_key_here
# 是否强制走云函数代理识别菜品（true/false），H5 默认自动走代理
VITE_BAIDU_AI_USE_CLOUD_PROXY=false

# uniCloud配置
UNICLOUD_SPACE_ID=your_space_id_here
UNICLOUD_SPACE_PROVIDER=aliyun

# 云函数环境变量（在 HBuilderX/unicloud 控制台配置，不进入 Vite 构建）
# 百度AI密钥（用于 baidu-dish 云函数代理）
BAIDU_API_KEY=your_api_key_here
BAIDU_SECRET_KEY=your_secret_key_here
# 微信小程序登录凭证（用于 user-login 云函数）
WX_APPID=your_wx_appid_here
WX_SECRET=your_wx_secret_here
